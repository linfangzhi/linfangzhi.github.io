---
import{getCollection}from'astro:content';import Base from'../layouts/Base.astro';const entries=await getCollection('content');const tags=[...new Set(entries.flatMap(e=>e.data.tags))].sort();
---
<Base title="Tags"><section class="hero"><h1>Tags</h1></section><div class="article">{tags.map(t=><span class="tag">{t}</span>)}</div></Base>
